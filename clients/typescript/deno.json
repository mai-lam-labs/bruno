{
  "name": "@mailam/bruno",
  "version": "0.4.1-dev.1",
  "license": "Apache-2.0",
  "exports": "./mod.ts",
  "publish": {
    "exclude": ["test"]
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@noble/curves": "jsr:@noble/curves@2.4.0",
    "@noble/hashes": "jsr:@noble/hashes@2.4.0",
    "@scure/bip32": "jsr:@scure/bip32@2.4.0",
    "@std/assert": "jsr:@std/assert@1.0.15"
  }
}
