  "operation": {
    "post": {
      "summary": "x402",
      "description": "Sends one EVM call and pays its gas, paid by an EIP-3009 authorization that's settled in the same transaction as the call: only if the call succeeds and is included. Post the call (to, data, its gas, an EIP-7702 authorization if any) for its price. Without one, the price is a reference call's: one authorization, 150,000 gas, 512 bytes of data.",
      "parameters": [
        {
          "name": "chain",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The chain's id, or its network's name"
        },
        {
          "name": "PAYMENT-SIGNATURE",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "x402's payment payload, base64 of its JSON"
        }
      ],
      "requestBody": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/X402Params"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Settled: its transaction included (PAYMENT-RESPONSE)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/X402Result"
              }
            }
          }
        },
        "402": {
          "description": "What to pay (PAYMENT-REQUIRED); why a payment wasn't taken",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequired"
              }
            }
          }
        }
      },
      "x-payment-info": {
        "protocols": [
          "x402"
        ],
        "price": {
          "mode": "dynamic",
          "currency": "USD"
        }
      }
    }
  },
