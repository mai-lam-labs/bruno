{
  "openrpc": "1.3.2",
  "info": {
    "title": "bruno",
    "description": "Permissionless post-paid gas relay",
    "version": "0.5.0"
  },
  "methods": [
    {
      "name": "postpaid_config",
      "summary": "Who to pay, in which tokens, and the limits",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "terms",
        "schema": {
          "$ref": "#/components/schemas/TermsResult"
        }
      },
      "errors": [],
      "examples": [
        {
          "name": "postpaid_config",
          "params": []
        }
      ]
    },
    {
      "name": "postpaid_quote",
      "summary": "What a call costs in each token",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "quote",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/QuoteParams"
          }
        }
      ],
      "result": {
        "name": "quotes",
        "schema": {
          "$ref": "#/components/schemas/QuoteResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        }
      ],
      "examples": [
        {
          "name": "postpaid_quote",
          "params": [
            {
              "name": "quote",
              "value": {
                "gas": "0x186a0",
                "callBytes": "0x200",
                "tokens": [
                  "0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "postpaid_sendTransaction",
      "summary": "Take a submission",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "submission",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/SendParams"
          }
        }
      ],
      "result": {
        "name": "id",
        "schema": {
          "$ref": "#/components/schemas/SendResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/UNDERPAID"
        },
        {
          "$ref": "#/components/errors/SIMULATION_FAILED"
        },
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        },
        {
          "$ref": "#/components/errors/NO_CAPACITY"
        }
      ]
    },
    {
      "name": "postpaid_getStatus",
      "summary": "What's become of a submission",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "description": "32 bytes, as hex",
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        }
      ],
      "result": {
        "name": "status",
        "schema": {
          "$ref": "#/components/schemas/StatusResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/UNKNOWN_SUBMISSION"
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "TermsResult": {
        "title": "TermsResult",
        "type": "object",
        "properties": {
          "payee": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "tokens": {
            "type": "array",
            "items": {
              "description": "An address",
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          "maxGas": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "maxCallBytes": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          }
        },
        "required": [
          "payee",
          "tokens",
          "maxGas",
          "maxCallBytes"
        ]
      },
      "QuoteParams": {
        "title": "QuoteParams",
        "description": "The call's gas and length, the account that will sign an authorization (none if\nthere isn't one), and the tokens to quote in; and, if the payment's a signed transfer,\nwho signs it, an account to deploy first, and the gas its signature check takes, each if\nknown.",
        "type": "object",
        "properties": {
          "gas": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "callBytes": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "tokens": {
            "type": "array",
            "items": {
              "description": "An address",
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          "authority": {
            "anyOf": [
              {
                "description": "An address",
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "payer": {
            "anyOf": [
              {
                "description": "An address",
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "deployment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentJson"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "verifyGas": {
            "anyOf": [
              {
                "description": "A quantity, as hex",
                "type": "string",
                "maxLength": 66,
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "gas",
          "callBytes",
          "tokens"
        ]
      },
      "DeploymentJson": {
        "title": "DeploymentJson",
        "description": "An account to deploy before the call, if it has no code: `factory` called with\n`factoryData` (ERC-4337's names).",
        "type": "object",
        "properties": {
          "account": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "factory": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "factoryData": {
            "description": "Bytes, as hex",
            "type": "string",
            "pattern": "^0x([0-9a-fA-F]{2})*$"
          }
        },
        "required": [
          "account",
          "factory",
          "factoryData"
        ]
      },
      "QuoteResult": {
        "title": "QuoteResult",
        "type": "object",
        "properties": {
          "validUntilBlock": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "quotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenQuote"
            }
          }
        },
        "required": [
          "validUntilBlock",
          "quotes"
        ]
      },
      "TokenQuote": {
        "title": "TokenQuote",
        "type": "object",
        "properties": {
          "token": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          }
        },
        "required": [
          "token",
          "amount"
        ]
      },
      "SendParams": {
        "title": "SendParams",
        "type": "object",
        "properties": {
          "call": {
            "$ref": "#/components/schemas/Call"
          },
          "gas": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentJson"
          },
          "maxBlockNumber": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "authorizationList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizationJson"
            },
            "default": []
          },
          "deployment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentJson"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "call",
          "gas",
          "payment",
          "maxBlockNumber"
        ]
      },
      "Call": {
        "title": "Call",
        "description": "EIP-5792's call, value 0.",
        "type": "object",
        "properties": {
          "to": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "data": {
            "description": "Bytes, as hex",
            "type": "string",
            "pattern": "^0x([0-9a-fA-F]{2})*$"
          }
        },
        "required": [
          "to",
          "data"
        ]
      },
      "PaymentJson": {
        "title": "PaymentJson",
        "type": "object",
        "properties": {
          "token": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "payee": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "transfer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TransferJson"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "token",
          "payee",
          "amount"
        ]
      },
      "TransferJson": {
        "title": "TransferJson",
        "description": "A payment's EIP-3009 transferWithAuthorization, signed: of the payment's amount, from\n`from` to its payee.",
        "type": "object",
        "properties": {
          "from": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "validAfter": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "validBefore": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "nonce": {
            "description": "32 bytes, as hex",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "signature": {
            "description": "A signature, as hex: a key's 65 bytes, a contract's, or ERC-6492-wrapped",
            "type": "string",
            "maxLength": 8194,
            "pattern": "^0x(?:[0-9a-fA-F]{2})+$"
          }
        },
        "required": [
          "from",
          "validAfter",
          "validBefore",
          "nonce",
          "signature"
        ]
      },
      "AuthorizationJson": {
        "title": "AuthorizationJson",
        "description": "An EIP-7702 authorization, as in a type-4 transaction's JSON.",
        "type": "object",
        "properties": {
          "chainId": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "address": {
            "description": "An address",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "nonce": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "yParity": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "r": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "s": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          }
        },
        "required": [
          "chainId",
          "address",
          "nonce",
          "yParity",
          "r",
          "s"
        ]
      },
      "SendResult": {
        "title": "SendResult",
        "type": "object",
        "properties": {
          "id": {
            "description": "32 bytes, as hex",
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        },
        "required": [
          "id"
        ]
      },
      "StatusResult": {
        "title": "StatusResult",
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "attempts": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
          },
          "transactionHash": {
            "anyOf": [
              {
                "description": "32 bytes, as hex",
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "blockNumber": {
            "anyOf": [
              {
                "description": "A quantity, as hex",
                "type": "string",
                "maxLength": 66,
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "confirmations": {
            "anyOf": [
              {
                "description": "A quantity, as hex",
                "type": "string",
                "maxLength": 66,
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "revertData": {
            "anyOf": [
              {
                "description": "Bytes, as hex",
                "type": "string",
                "pattern": "^0x([0-9a-fA-F]{2})*$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "status",
          "stage",
          "attempts"
        ]
      }
    },
    "errors": {
      "INVALID_PARAMS": {
        "code": -32602,
        "message": "Invalid params"
      },
      "UNDERPAID": {
        "code": -32010,
        "message": "Underpaid at the next block's price"
      },
      "SIMULATION_FAILED": {
        "code": -32011,
        "message": "Simulation failed"
      },
      "UNSUPPORTED": {
        "code": -32012,
        "message": "Unsupported token or payee"
      },
      "NO_CAPACITY": {
        "code": -32013,
        "message": "No capacity: the queue is full of more profitable submissions"
      },
      "UNKNOWN_SUBMISSION": {
        "code": -32014,
        "message": "Unknown submission"
      }
    }
  },
  "servers": []
}
