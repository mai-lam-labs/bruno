{
  "openrpc": "1.3.2",
  "info": {
    "title": "bruno",
    "description": "Permissionless post-paid gas relay",
    "version": "0.5.1"
  },
  "methods": [
    {
      "name": "postpaid_config",
      "summary": "Who to pay, in which tokens, and the limits",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "terms",
        "schema": {
          "$ref": "#/components/schemas/TermsResult"
        }
      },
      "errors": [],
      "examples": [
        {
          "name": "postpaid_config",
          "params": []
        }
      ]
    },
    {
      "name": "postpaid_quote",
      "summary": "What a call costs in each token",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "quote",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/QuoteParams"
          }
        }
      ],
      "result": {
        "name": "quotes",
        "schema": {
          "$ref": "#/components/schemas/QuoteResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        }
      ],
      "examples": [
        {
          "name": "postpaid_quote",
          "params": [
            {
              "name": "quote",
              "value": {
                "gas": "0x186a0",
                "callBytes": "0x200",
                "tokens": [
                  "0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "postpaid_sendTransaction",
      "summary": "Take a submission",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "submission",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/SendParams"
          }
        }
      ],
      "result": {
        "name": "id",
        "schema": {
          "$ref": "#/components/schemas/SendResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/UNDERPAID"
        },
        {
          "$ref": "#/components/errors/SIMULATION_FAILED"
        },
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        },
        {
          "$ref": "#/components/errors/NO_CAPACITY"
        }
      ]
    },
    {
      "name": "postpaid_getStatus",
      "summary": "What's become of a submission",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "description": "32 bytes, as hex",
            "type": "string",
            "pattern": "^(?:0x[0-9a-f]{64})(?![\\s\\S])"
          }
        }
      ],
      "result": {
        "name": "status",
        "schema": {
          "$ref": "#/components/schemas/StatusResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/UNKNOWN_SUBMISSION"
        }
      ]
    },
    {
      "name": "eth_estimateUserOperationGas",
      "summary": "A user operation's gas limits (ERC-7769), paying by its fees or by its calls",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "userOperation",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UserOperationJson"
          }
        },
        {
          "name": "entryPoint",
          "required": true,
          "schema": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          }
        }
      ],
      "result": {
        "name": "gas",
        "schema": {
          "$ref": "#/components/schemas/GasEstimateResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/SIMULATION_FAILED"
        }
      ]
    },
    {
      "name": "postpaid_quoteUserOperation",
      "summary": "What a user operation paying by its calls is to pay, in each token, before it's signed",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "userOperation",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UserOperationJson"
          }
        },
        {
          "name": "entryPoint",
          "required": true,
          "schema": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          }
        }
      ],
      "result": {
        "name": "quotes",
        "schema": {
          "$ref": "#/components/schemas/QuoteResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/SIMULATION_FAILED"
        },
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        }
      ]
    },
    {
      "name": "eth_sendUserOperation",
      "summary": "Take a user operation (ERC-7769), paying by its fees or by its calls: its hash",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "userOperation",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UserOperationJson"
          }
        },
        {
          "name": "entryPoint",
          "required": true,
          "schema": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          }
        }
      ],
      "result": {
        "name": "userOpHash",
        "schema": {
          "description": "32 bytes, as hex",
          "type": "string",
          "pattern": "^(?:0x[0-9a-f]{64})(?![\\s\\S])"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/UNDERPAID"
        },
        {
          "$ref": "#/components/errors/SIMULATION_FAILED"
        },
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        },
        {
          "$ref": "#/components/errors/NO_CAPACITY"
        }
      ]
    },
    {
      "name": "eth_getUserOperationReceipt",
      "summary": "A user operation's receipt (ERC-7769): null until it's included",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "userOpHash",
          "required": true,
          "schema": {
            "description": "32 bytes, as hex",
            "type": "string",
            "pattern": "^(?:0x[0-9a-f]{64})(?![\\s\\S])"
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/UserOperationReceiptJson"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        }
      ]
    },
    {
      "name": "pimlico_getUserOperationGasPrice",
      "summary": "The price a user operation paying by its fees is asked, as both its fees",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "gasPrice",
        "schema": {
          "$ref": "#/components/schemas/GasPriceResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        }
      ],
      "examples": [
        {
          "name": "pimlico_getUserOperationGasPrice",
          "params": []
        }
      ]
    },
    {
      "name": "zd_getUserOperationGasPrice",
      "summary": "The price a user operation paying by its fees is asked, as both its fees",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "gasPrice",
        "schema": {
          "$ref": "#/components/schemas/GasPriceResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/UNSUPPORTED"
        }
      ],
      "examples": [
        {
          "name": "zd_getUserOperationGasPrice",
          "params": []
        }
      ]
    },
    {
      "name": "eth_supportedEntryPoints",
      "summary": "The EntryPoints taken (ERC-7769): v0.7's",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "entryPoints",
        "schema": {
          "type": "array",
          "items": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          }
        }
      },
      "errors": [],
      "examples": [
        {
          "name": "eth_supportedEntryPoints",
          "params": []
        }
      ]
    },
    {
      "name": "eth_chainId",
      "summary": "The chain's id",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "chainId",
        "schema": {
          "description": "A quantity, as hex",
          "type": "string",
          "maxLength": 66,
          "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
        }
      },
      "errors": [],
      "examples": [
        {
          "name": "eth_chainId",
          "params": []
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "TermsResult": {
        "title": "TermsResult",
        "type": "object",
        "properties": {
          "payee": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "tokens": {
            "type": "array",
            "items": {
              "description": "An address",
              "type": "string",
              "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
            }
          },
          "maxGas": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "maxCallBytes": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          }
        },
        "required": [
          "payee",
          "tokens",
          "maxGas",
          "maxCallBytes"
        ]
      },
      "QuoteParams": {
        "title": "QuoteParams",
        "description": "The call's gas and length, the account that will sign an authorization (none if\nthere isn't one), and the tokens to quote in; `payer`, the account a signed transfer pays\nfrom, if one pays (without it, the call pays for itself), and the gas its signature check\ntakes, if known, only with it; and an account to deploy first, if any.",
        "type": "object",
        "properties": {
          "gas": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "callBytes": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "tokens": {
            "type": "array",
            "items": {
              "description": "An address",
              "type": "string",
              "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
            }
          },
          "authority": {
            "anyOf": [
              {
                "description": "An address",
                "type": "string",
                "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "payer": {
            "anyOf": [
              {
                "description": "An address",
                "type": "string",
                "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "deployment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentJson"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "verifyGas": {
            "anyOf": [
              {
                "description": "A quantity, as hex",
                "type": "string",
                "maxLength": 66,
                "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "gas",
          "callBytes",
          "tokens"
        ]
      },
      "DeploymentJson": {
        "title": "DeploymentJson",
        "description": "An account to deploy before the call, if it has no code: `factory` called with\n`factoryData` (ERC-4337's names).",
        "type": "object",
        "properties": {
          "account": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "factory": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "factoryData": {
            "description": "Bytes, as hex",
            "type": "string",
            "pattern": "^(?:0x([0-9a-fA-F]{2})*)(?![\\s\\S])"
          }
        },
        "required": [
          "account",
          "factory",
          "factoryData"
        ]
      },
      "QuoteResult": {
        "title": "QuoteResult",
        "type": "object",
        "properties": {
          "validUntilBlock": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "quotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenQuote"
            }
          }
        },
        "required": [
          "validUntilBlock",
          "quotes"
        ]
      },
      "TokenQuote": {
        "title": "TokenQuote",
        "type": "object",
        "properties": {
          "token": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "amount": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          }
        },
        "required": [
          "token",
          "amount"
        ]
      },
      "SendParams": {
        "title": "SendParams",
        "type": "object",
        "properties": {
          "call": {
            "$ref": "#/components/schemas/Call"
          },
          "gas": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentJson"
          },
          "maxBlockNumber": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "authorizationList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizationJson"
            },
            "default": []
          },
          "deployment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentJson"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "call",
          "gas",
          "payment",
          "maxBlockNumber"
        ]
      },
      "Call": {
        "title": "Call",
        "description": "EIP-5792's call, value 0.",
        "type": "object",
        "properties": {
          "to": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "data": {
            "description": "Bytes, as hex",
            "type": "string",
            "pattern": "^(?:0x([0-9a-fA-F]{2})*)(?![\\s\\S])"
          }
        },
        "required": [
          "to",
          "data"
        ]
      },
      "PaymentJson": {
        "title": "PaymentJson",
        "type": "object",
        "properties": {
          "token": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "payee": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "amount": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "transfer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TransferJson"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "token",
          "payee",
          "amount"
        ]
      },
      "TransferJson": {
        "title": "TransferJson",
        "description": "A payment's EIP-3009 transferWithAuthorization, signed: of the payment's amount, from\n`from` to its payee.",
        "type": "object",
        "properties": {
          "from": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "validAfter": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "validBefore": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "nonce": {
            "description": "32 bytes, as hex",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{64})(?![\\s\\S])"
          },
          "signature": {
            "description": "A signature, as hex: a key's 65 bytes, a contract's, or ERC-6492-wrapped",
            "type": "string",
            "maxLength": 8194,
            "pattern": "^(?:0x(?:[0-9a-fA-F]{2})+)(?![\\s\\S])"
          }
        },
        "required": [
          "from",
          "validAfter",
          "validBefore",
          "nonce",
          "signature"
        ]
      },
      "AuthorizationJson": {
        "title": "AuthorizationJson",
        "description": "An EIP-7702 authorization, as in a type-4 transaction's JSON (its signature's numbers\npadded or not).",
        "type": "object",
        "properties": {
          "chainId": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "address": {
            "description": "An address",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
          },
          "nonce": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "yParity": {
            "description": "A word, as hex",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{1,64})(?![\\s\\S])"
          },
          "r": {
            "description": "A word, as hex",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{1,64})(?![\\s\\S])"
          },
          "s": {
            "description": "A word, as hex",
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{1,64})(?![\\s\\S])"
          }
        },
        "required": [
          "chainId",
          "address",
          "nonce",
          "yParity",
          "r",
          "s"
        ]
      },
      "SendResult": {
        "title": "SendResult",
        "type": "object",
        "properties": {
          "id": {
            "description": "32 bytes, as hex",
            "type": "string",
            "pattern": "^(?:0x[0-9a-f]{64})(?![\\s\\S])"
          }
        },
        "required": [
          "id"
        ]
      },
      "StatusResult": {
        "title": "StatusResult",
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "attempts": {
            "description": "A quantity, as hex",
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
          },
          "transactionHash": {
            "anyOf": [
              {
                "description": "32 bytes, as hex",
                "type": "string",
                "pattern": "^(?:0x[0-9a-f]{64})(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "blockNumber": {
            "anyOf": [
              {
                "description": "A quantity, as hex",
                "type": "string",
                "maxLength": 66,
                "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "confirmations": {
            "anyOf": [
              {
                "description": "A quantity, as hex",
                "type": "string",
                "maxLength": 66,
                "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "revertData": {
            "anyOf": [
              {
                "description": "Bytes, as hex",
                "type": "string",
                "pattern": "^(?:0x([0-9a-fA-F]{2})*)(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "status",
          "stage",
          "attempts"
        ]
