        "summary": "postpaid_config",
        "operationId": "ChainV1ConfigGetConfig",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[a-z][a-z0-9-]*)(?![\\s\\S])"
            },
            "required": true,
            "deprecated": false
          }
        ],
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TermsResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such path, the chain isn't served, or no such submission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "No capacity, or the chain can't be served now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/{chain}/v1/quote": {
      "get": {
        "summary": "postpaid_quote",
        "operationId": "ChainV1QuoteGetQuote",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[a-z][a-z0-9-]*)(?![\\s\\S])"
            },
            "required": true,
            "deprecated": false
          },
          {
            "name": "gas",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
              "examples": [
                "0x186a0"
              ]
            },
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false,
            "examples": {
              "gas-example-1": {
                "value": "0x186a0"
              }
            }
          },
          {
            "name": "callBytes",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
              "examples": [
                "0x200"
              ]
            },
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false,
            "examples": {
              "call_bytes-example-1": {
                "value": "0x200"
              }
            }
          },
          {
            "name": "tokens",
            "in": "query",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "minItems": 1,
              "examples": [
                [
                  "0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE"
                ]
              ]
            },
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false,
            "examples": {
              "tokens-example-1": {
                "value": [
                  "0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE"
                ]
              }
            }
          },
          {
            "name": "authority",
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
            },
            "required": false,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "payer",
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])",
              "description": "The account a signed transfer pays from (its `from`): given, the payment is that transfer; not given, the call pays for itself"
            },
            "description": "The account a signed transfer pays from (its `from`): given, the payment is that transfer; not given, the call pays for itself",
            "required": false,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "verifyGas",
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
              "description": "The gas the payer's signature check takes, if known: only with `payer`"
            },
            "description": "The gas the payer's signature check takes, if known: only with `payer`",
            "required": false,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "account",
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
            },
            "required": false,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "factory",
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])"
            },
            "required": false,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "factoryData",
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "pattern": "^(?:0x([0-9a-fA-F]{2})*)(?![\\s\\S])"
            },
            "required": false,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          }
        ],
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such path, the chain isn't served, or no such submission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Underpaid, simulation failed, or an unsupported token or payee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "No capacity, or the chain can't be served now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/{chain}/v1/submissions": {
      "post": {
        "summary": "postpaid_sendTransaction",
        "operationId": "ChainV1SubmissionsPostSubmission",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[a-z][a-z0-9-]*)(?![\\s\\S])"
            },
            "required": true,
            "deprecated": false
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Request accepted, processing continues off-line",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "200": {
            "description": "Taken already",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            }
          },
          "404": {
            "description": "No such path, the chain isn't served, or no such submission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Underpaid, simulation failed, or an unsupported token or payee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "No capacity, or the chain can't be served now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
