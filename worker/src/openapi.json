    "/openapi.json": {
      "get": {
        "summary": "OpenAPI",
        "operationId": "OpenapiJsonGetOpenapi",
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {},
                  "type": "object"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/{chain}": {
      "post": {
        "summary": "JSON-RPC",
        "operationId": "ChainJsonRpc",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[a-z][a-z0-9-]*)(?![\\s\\S])"
            },
            "required": true,
            "deprecated": false
          }
        ],
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request syntax or unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status_code": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "extra": {
