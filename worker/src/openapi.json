  },
  "components": {
    "schemas": {
      "AuthorizationJson": {
        "properties": {
          "chainId": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "An address"
          },
          "nonce": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "yParity": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "r": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "s": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          }
        },
        "type": "object",
        "required": [
          "address",
          "chainId",
          "nonce",
          "r",
          "s",
          "yParity"
        ],
        "title": "AuthorizationJson"
      },
      "Call": {
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "An address"
          },
          "data": {
            "type": "string",
            "pattern": "^0x([0-9a-fA-F]{2})*$",
            "description": "Bytes, as hex"
          }
        },
        "type": "object",
        "required": [
          "data",
          "to"
        ],
        "title": "Call"
      },
      "Code": {
        "type": "integer",
        "enum": [
          -32700,
          -32600,
          -32601,
          -32602,
          -32603,
          -32010,
          -32011,
          -32012,
          -32013,
          -32014
        ],
        "title": "Code",
        "description": "JSON-RPC 2.0's own error codes, and the relay's."
      },
      "ErrorObject": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Code"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "oneOf": [
              {},
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorObject"
      },
      "PaymentJson": {
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "An address"
          },
          "payee": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "An address"
          },
          "amount": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "payee",
          "token"
        ],
        "title": "PaymentJson"
      },
      "QuoteResult": {
        "properties": {
          "validUntilBlock": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "quotes": {
            "items": {
              "$ref": "#/components/schemas/TokenQuote"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "quotes",
          "validUntilBlock"
        ],
        "title": "QuoteResult"
      },
      "RpcResponse": {
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "jsonrpc": {
            "type": "string",
            "default": "2.0"
          },
          "result": {
            "oneOf": [
              {}
            ]
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorObject"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "RpcResponse"
      },
      "SendParams": {
        "properties": {
          "call": {
            "$ref": "#/components/schemas/Call"
          },
          "gas": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentJson"
          },
          "maxBlockNumber": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "authorizationList": {
            "items": {
              "$ref": "#/components/schemas/AuthorizationJson"
            },
            "type": "array",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "call",
          "gas",
          "maxBlockNumber",
          "payment"
        ],
        "title": "SendParams"
      },
      "SendResult": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "description": "32 bytes, as hex"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "SendResult"
      },
      "StatusResult": {
        "properties": {
          "status": {
            "type": "string"
          },
          "attempts": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "transactionHash": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "pattern": "^0x[0-9a-f]{64}$",
            "description": "32 bytes, as hex"
          },
          "blockNumber": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "reason": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "revertData": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "pattern": "^0x([0-9a-fA-F]{2})*$",
            "description": "Bytes, as hex"
          }
        },
        "type": "object",
        "required": [
          "attempts",
          "status"
        ],
        "title": "StatusResult"
      },
      "TermsResult": {
        "properties": {
          "payee": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "An address"
          },
          "tokens": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxGas": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          },
          "maxCallBytes": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          }
        },
        "type": "object",
        "required": [
          "maxCallBytes",
          "maxGas",
          "payee",
          "tokens"
        ],
        "title": "TermsResult"
      },
      "TokenQuote": {
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "An address"
          },
          "amount": {
            "type": "string",
            "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
            "description": "A quantity, as hex"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "token"
        ],
        "title": "TokenQuote"
      }
    }
  }
}
