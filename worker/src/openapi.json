{
  "info": {
    "title": "bruno",
    "version": "0.1.0",
    "description": "Permissionless post-paid gas relay"
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/{chain}/v1/config": {
      "get": {
        "summary": "postpaid_config",
        "operationId": "ChainV1ConfigGetConfig",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,14}|[a-z][a-z0-9-]*)$"
            },
            "required": true,
            "deprecated": false
          }
        ],
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TermsResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request syntax or unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status_code": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "extra": {
                      "additionalProperties": {},
                      "type": [
                        "null",
                        "object",
                        "array"
                      ]
                    }
                  },
                  "type": "object",
                  "required": [
                    "detail",
                    "status_code"
                  ],
                  "description": "Validation Exception",
                  "examples": [
                    {
                      "status_code": 400,
                      "detail": "Bad Request",
                      "extra": {}
                    }
                  ]
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/{chain}/v1/quote": {
      "get": {
        "summary": "postpaid_quote",
        "operationId": "ChainV1QuoteGetQuote",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,14}|[a-z][a-z0-9-]*)$"
            },
            "required": true,
            "deprecated": false
          },
          {
            "name": "gas",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
            },
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "callBytes",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
            },
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "tokens",
            "in": "query",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "minItems": 1
            },
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          },
          {
            "name": "authority",
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "required": false,
            "deprecated": false,
            "allowEmptyValue": false,
            "allowReserved": false
          }
        ],
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request syntax or unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status_code": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "extra": {
                      "additionalProperties": {},
                      "type": [
                        "null",
                        "object",
                        "array"
                      ]
                    }
                  },
                  "type": "object",
                  "required": [
                    "detail",
                    "status_code"
                  ],
                  "description": "Validation Exception",
                  "examples": [
                    {
                      "status_code": 400,
                      "detail": "Bad Request",
                      "extra": {}
                    }
                  ]
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/{chain}/v1/submissions": {
      "post": {
        "summary": "postpaid_sendTransaction",
        "operationId": "ChainV1SubmissionsPostSubmission",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,14}|[a-z][a-z0-9-]*)$"
            },
            "required": true,
            "deprecated": false
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Document created, URL follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request syntax or unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status_code": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "extra": {
                      "additionalProperties": {},
                      "type": [
                        "null",
                        "object",
                        "array"
                      ]
                    }
                  },
                  "type": "object",
                  "required": [
                    "detail",
                    "status_code"
                  ],
                  "description": "Validation Exception",
                  "examples": [
                    {
                      "status_code": 400,
                      "detail": "Bad Request",
                      "extra": {}
                    }
                  ]
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/{chain}/v1/submissions/{submission_id}": {
      "get": {
        "summary": "postpaid_getStatus",
        "operationId": "ChainV1SubmissionsSubmissionIdGetSubmission",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,14}|[a-z][a-z0-9-]*)$"
            },
            "required": true,
            "deprecated": false
          },
          {
            "name": "submission_id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "required": true,
            "deprecated": false
          }
        ],
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
