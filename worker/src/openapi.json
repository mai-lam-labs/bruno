  "components": {
    "schemas": {
      "AuthorizationJson": {
        "properties": {
          "chainId": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "address": {
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])",
            "description": "An address"
          },
          "nonce": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "yParity": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "r": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "s": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          }
        },
        "type": "object",
        "required": [
          "address",
          "chainId",
          "nonce",
          "r",
          "s",
          "yParity"
        ],
        "title": "AuthorizationJson"
      },
      "Call": {
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])",
            "description": "An address"
          },
          "data": {
            "type": "string",
            "pattern": "^(?:0x([0-9a-fA-F]{2})*)(?![\\s\\S])",
            "description": "Bytes, as hex"
          }
        },
        "type": "object",
        "required": [
          "data",
          "to"
        ],
        "title": "Call"
      },
      "Code": {
        "type": "integer",
        "enum": [
          -32700,
          -32600,
          -32601,
          -32602,
          -32603,
          -32010,
          -32011,
          -32012,
          -32013,
          -32014,
          -32015
        ],
        "title": "Code",
        "description": "JSON-RPC 2.0's own error codes, and the relay's."
      },
      "DeploymentJson": {
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])",
            "description": "An address"
          },
          "factory": {
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])",
            "description": "An address"
          },
          "factoryData": {
            "type": "string",
            "pattern": "^(?:0x([0-9a-fA-F]{2})*)(?![\\s\\S])",
            "description": "Bytes, as hex"
          }
        },
        "type": "object",
        "required": [
          "account",
          "factory",
          "factoryData"
        ],
        "title": "DeploymentJson"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorObject"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorBody"
      },
      "ErrorObject": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Code"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "oneOf": [
              {},
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorObject"
      },
      "PaymentJson": {
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])",
            "description": "An address"
          },
          "payee": {
            "type": "string",
            "pattern": "^(?:0x[0-9a-fA-F]{40})(?![\\s\\S])",
            "description": "An address"
          },
          "amount": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "transfer": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TransferJson"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "amount",
          "payee",
          "token"
        ],
        "title": "PaymentJson"
      },
      "QuoteResult": {
        "properties": {
          "validUntilBlock": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "quotes": {
            "items": {
              "$ref": "#/components/schemas/TokenQuote"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "quotes",
          "validUntilBlock"
        ],
        "title": "QuoteResult"
      },
      "RpcResponse": {
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "jsonrpc": {
            "type": "string",
            "default": "2.0"
          },
          "result": {
            "oneOf": [
              {}
            ]
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorObject"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "RpcResponse"
      },
      "SendParams": {
        "properties": {
          "call": {
            "$ref": "#/components/schemas/Call"
          },
          "gas": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentJson"
          },
          "maxBlockNumber": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "authorizationList": {
            "items": {
              "$ref": "#/components/schemas/AuthorizationJson"
            },
            "type": "array",
            "default": []
          },
          "deployment": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeploymentJson"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "call",
          "gas",
          "maxBlockNumber",
          "payment"
        ],
        "title": "SendParams"
      },
      "SendResult": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:0x[0-9a-f]{64})(?![\\s\\S])",
            "description": "32 bytes, as hex"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "SendResult"
      },
      "StatusResult": {
        "properties": {
          "status": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "attempts": {
            "type": "string",
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "transactionHash": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "pattern": "^(?:0x[0-9a-f]{64})(?![\\s\\S])",
            "description": "32 bytes, as hex"
          },
          "blockNumber": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "maxLength": 66,
            "pattern": "^(?:0x(0|[1-9a-f][0-9a-f]*))(?![\\s\\S])",
            "description": "A quantity, as hex"
          },
          "confirmations": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
